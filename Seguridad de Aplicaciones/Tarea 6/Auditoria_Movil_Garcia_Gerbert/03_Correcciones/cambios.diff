+    private String maskCardNumber(String ccNumber) {
+        if (ccNumber == null || ccNumber.length() < 4) {
+            return "****";
+        }
+        String lastFour = ccNumber.substring(ccNumber.length() - 4);
+        return "****" + lastFour;
+    }
